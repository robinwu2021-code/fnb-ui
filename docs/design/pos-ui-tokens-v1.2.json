{
  "meta": {
    "schema": "fnb-pos-ui/1",
    "version": "1.2.0",
    "date": "2026-11-02",
    "platform": "android",
    "theme": "pine-light",
    "defaultDensity": "standard",
    "status": "specification-not-runtime-wired",
    "spec": "../全线点餐POS-UI视觉规范-v1.2.md",
    "format": "Project-specific resolved tokens; not a DTCG interchange file"
  },
  "units": {
    "dimension": "dp",
    "fontSize": "sp",
    "lineHeight": "sp",
    "duration": "ms",
    "fontWeight": "numeric",
    "opacity": "0..1"
  },
  "font": {
    "family": "Manrope",
    "fallback": "Noto Sans SC, Android sans-serif",
    "numberFeature": "tnum",
    "letterSpacing": 0,
    "chineseFamily": "Noto Sans SC"
  },
  "typography": {
    "caption": {
      "size": 12,
      "lineHeight": 16,
      "weight": 400
    },
    "support": {
      "size": 16,
      "lineHeight": 24,
      "weight": 400
    },
    "body": {
      "size": 18,
      "lineHeight": 28,
      "weight": 400
    },
    "label": {
      "size": 18,
      "lineHeight": 28,
      "weight": 600
    },
    "title": {
      "size": 24,
      "lineHeight": 32,
      "weight": 600
    },
    "page": {
      "size": 32,
      "lineHeight": 40,
      "weight": 600
    },
    "amount": {
      "size": 40,
      "lineHeight": 48,
      "weight": 700
    },
    "result": {
      "size": 48,
      "lineHeight": 56,
      "weight": 700
    }
  },
  "space": {
    "none": 0,
    "micro": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 20,
    "xl": 24,
    "xxl": 32
  },
  "density": {
    "standard": {
      "pagePadding": 24,
      "panelGap": 24,
      "panelPadding": 24,
      "cardGap": 20,
      "sectionGap": 32,
      "controlGap": 8,
      "fieldGap": 16,
      "rowMinHeight": 64
    },
    "compact": {
      "pagePadding": 12,
      "panelGap": 12,
      "panelPadding": 16,
      "cardGap": 12,
      "sectionGap": 20,
      "controlGap": 8,
      "fieldGap": 12,
      "rowMinHeight": 56
    }
  },
  "layout": {
    "breakpoints": {
      "handheld": 600,
      "multiPane": 960,
      "wide": 1280
    },
    "shortHeight": 480,
    "systemBarMinHeight": 64,
    "compactTopBarMinHeight": 56,
    "bottomNavMinHeight": 64,
    "resourceRail": {
      "category": 96,
      "zone": 128,
      "settings": 160
    },
    "detailWidth": {
      "medium": 320,
      "wide": 380,
      "max": 400
    },
    "paymentPaneMaxWidth": 560,
    "dialog": {
      "maxWidth": 560,
      "wideMaxWidth": 760,
      "outerMargin": 24
    },
    "sheet": {
      "sideWidth": 480,
      "maxHeightFraction": 0.9
    },
    "grid": {
      "dishMinWidth": 144,
      "dishMaxWidth": 200,
      "tableMinWidth": 128,
      "tableMaxWidth": 200
    },
    "viewportUnitNote": "Measure actual safe content constraints; include insets exactly once"
  },
  "radius": {
    "tag": 4,
    "control": 12,
    "card": 4,
    "panel": 8,
    "dialog": 12,
    "capsule": "50%"
  },
  "stroke": {
    "divider": 0,
    "field": 0,
    "selected": 2,
    "error": 2,
    "focus": 2,
    "focusGap": 2,
    "icon": 1.75
  },
  "elevation": {
    "base": 0,
    "sticky": 0,
    "menu": 4,
    "modal": 8
  },
  "layer": {
    "content": 0,
    "sticky": 10,
    "menu": 20,
    "scrim": 30,
    "modal": 40,
    "feedback": 50
  },
  "motion": {
    "press": 120,
    "state": 180,
    "panel": 240,
    "reduced": 0
  },
  "color": {
    "canvas": "#F3F5F4",
    "surface": "#FFFFFF",
    "surfaceSubtle": "#F8FAF9",
    "control": "#F5F7F6",
    "controlPressed": "#EAF0ED",
    "text": "#181A1C",
    "textSecondary": "#5C5E61",
    "textDisabled": "#76797D",
    "icon": "#5C5E61",
    "lineDecorative": "#FFFFFF",
    "lineControl": "#76797D",
    "primary": "#306F5F",
    "primaryHover": "#215749",
    "primaryPressed": "#174237",
    "onPrimary": "#FFFFFF",
    "selected": "#DFF2EC",
    "selectedPressed": "#D1E9E1",
    "selectedText": "#306F5F",
    "focus": "#1C51D9",
    "focusGap": "#FFFFFF",
    "inverse": "#313335",
    "onInverse": "#FFFFFF",
    "dangerSolid": "#B70F0F",
    "dangerHover": "#930001",
    "dangerPressed": "#720001",
    "onDanger": "#FFFFFF",
    "scrim": {
      "hex": "#0C0E12",
      "alpha": 0.45
    },
    "actionSurface": "#F0F5F2",
    "tileSurface": "#F6F8F7"
  },
  "status": {
    "action": {
      "label": "待处理",
      "form": "chip",
      "icon": "#AD6200",
      "text": "#8F5000",
      "container": "#FFD1A9"
    },
    "progress": {
      "label": "进行中",
      "form": "inline",
      "icon": "#0076DE",
      "text": "#004A93",
      "container": "#C2DDFF"
    },
    "waiting": {
      "label": "等待中",
      "form": "inline",
      "icon": "#00888E",
      "text": "#00575B",
      "container": "#B4E5E8"
    },
    "done": {
      "label": "已完成",
      "form": "inline",
      "icon": "#008F50",
      "text": "#005C31",
      "container": "#B1EBC4"
    },
    "booked": {
      "label": "预约",
      "form": "chip",
      "icon": "#9E49CA",
      "text": "#8436AC",
      "container": "#EBCDFF"
    },
    "held": {
      "label": "暂存",
      "form": "chip",
      "icon": "#688400",
      "text": "#415400",
      "container": "#D1E3AE"
    },
    "trace": {
      "label": "变更标记",
      "form": "inline",
      "icon": "#C63288",
      "text": "#A81E70",
      "container": "#FFC9E1"
    },
    "closed": {
      "label": "已关闭",
      "form": "inline",
      "icon": "#848689",
      "text": "#67696B",
      "container": "#EDEFF2"
    },
    "failed": {
      "label": "异常",
      "form": "chip",
      "icon": "#D82821",
      "text": "#B70F0F",
      "container": "#FECDC6"
    }
  },
  "component": {
    "button": {
      "minHeight": 48,
      "primaryMinHeight": 56,
      "horizontalPadding": 20,
      "iconSize": 20,
      "iconGap": 8,
      "radius": 12,
      "textStyle": "label"
    },
    "iconButton": {
      "minWidth": 48,
      "minHeight": 48,
      "iconSize": 24,
      "radius": 12
    },
    "input": {
      "minHeight": 56,
      "horizontalPadding": 16,
      "labelGap": 8,
      "supportGap": 4,
      "radius": 12,
      "textStyle": "body"
    },
    "filterChip": {
      "minHeight": 48,
      "horizontalPadding": 16,
      "iconSize": 20,
      "radius": "50%",
      "textStyle": "label"
    },
    "segmented": {
      "minHeight": 56,
      "segmentMinHeight": 48,
      "padding": 4,
      "radius": 8,
      "textStyle": "label"
    },
    "choiceTile": {
      "minHeight": 64,
      "padding": 12,
      "radius": 12,
      "textStyle": "label"
    },
    "statusLabel": {
      "minHeight": 32,
      "paddingX": 8,
      "paddingY": 4,
      "iconSize": 16,
      "gap": 4,
      "radius": 4,
      "textStyle": "support",
      "interactive": false
    },
    "stepper": {
      "buttonSize": 48,
      "valueMinWidth": 40,
      "radius": 8,
      "textStyle": "label"
    },
    "checkbox": {
      "visualSize": 24,
      "touchSize": 48,
      "radius": 4
    },
    "radio": {
      "visualSize": 24,
      "touchSize": 48
    },
    "switch": {
      "visualWidth": 52,
      "visualHeight": 32,
      "touchHeight": 48
    },
    "navItem": {
      "minHeight": 48,
      "paddingX": 12,
      "paddingY": 12,
      "radius": 8,
      "textStyle": "label"
    },
    "dishCard": {
      "padding": 12,
      "textMinHeight": 144,
      "imageAspectRatio": "3:2",
      "titleMaxLines": 2,
      "radius": 4
    },
    "tableCard": {
      "minHeight": 144,
      "padding": 12,
      "radius": 4,
      "tableStyle": "title"
    },
    "orderLine": {
      "minHeight": 88,
      "padding": 12,
      "nameStyle": "label",
      "metadataStyle": "support"
    },
    "amountSummary": {
      "rowMinHeight": 32,
      "amountStyle": "amount",
      "detailStyle": "support"
    },
    "cashKey": {
      "minHeight": 56,
      "gap": 8,
      "radius": 12,
      "textStyle": "title"
    },
    "dialog": {
      "padding": 24,
      "sectionGap": 24,
      "actionGap": 8,
      "radius": 12
    },
    "sheet": {
      "padding": 20,
      "radius": 12
    },
    "banner": {
      "minHeight": 48,
      "padding": 12,
      "textStyle": "support"
    },
    "snackbar": {
      "minHeight": 48,
      "paddingX": 16,
      "paddingY": 12,
      "radius": 8,
      "textStyle": "support"
    },
    "menuItem": {
      "minHeight": 48,
      "paddingX": 16,
      "iconSize": 20,
      "textStyle": "body"
    },
    "emptyState": {
      "iconSize": 40,
      "sectionGap": 16,
      "titleStyle": "title",
      "supportStyle": "support"
    },
    "badge": {
      "visualMinSize": 20,
      "textStyle": "caption",
      "interactive": false
    }
  },
  "accessibility": {
    "minTouchTarget": 48,
    "textContrastMin": 4.5,
    "essentialGraphicContrastMin": 3,
    "fontScalesToTest": [
      1,
      1.3,
      2
    ],
    "colorOnlyMeaning": false,
    "fixedTextHeight": false
  },
  "rules": {
    "statusSurface": "Inline status renders on surface or its own container; otherwise use its own container",
    "selectedTextSurface": "selectedText only on surface, selected, selectedPressed; never on controlPressed",
    "disabledReason": "Use textSecondary for the reason; never rely on textDisabled to communicate required information",
    "modalPrimary": "One primary action in the active task; background is inert while modal is open",
    "tokenResolution": "Values are resolved snapshots; repeated component values must match foundations when updating",
    "fieldBoundary": "No gray stroke; persistent label, subtle surface and optional soft shadow; colored focus/error cues remain",
    "regionBoundary": "White panels on a very light canvas; 24dp gutters; tinted action footer; no gray strokes; panel shadow optional"
  },
  "localization": {
    "supported": [
      "zh-CN",
      "en"
    ],
    "default": "zh-CN",
    "persist": true,
    "currencyIndependentOfLanguage": true
  },
  "shadow": {
    "floating": {
      "color": "#18221E",
      "alpha": 0.1,
      "blur": 24,
      "offsetY": 6,
      "spread": 0
    },
    "field": {
      "color": "#18221E",
      "alpha": 0.06,
      "blur": 12,
      "offsetY": 2,
      "spread": 0
    },
    "panel": {
      "color": "#18221E",
      "alpha": 0.05,
      "blur": 20,
      "offsetY": 4,
      "spread": 0
    }
  }
}
